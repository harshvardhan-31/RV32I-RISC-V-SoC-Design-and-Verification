# TEMPLATE — runs only once RTL exists.
read_verilog -sv rtl/core/*.sv rtl/memory/*.sv rtl/bus/*.sv rtl/peripherals/*.sv rtl/top/*.sv
hierarchy -check -top rv32i_soc_top
synth -top rv32i_soc_top
# Technology mapping (Liberty file TBD):
